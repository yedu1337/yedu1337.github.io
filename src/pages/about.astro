---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { SITE } from '../consts';
import { toolbox } from '../data/toolbox';
---

<BaseLayout title="About" description={`About ${SITE.name} — a cybersecurity-focused developer building encrypted tunnels, real-time detection systems, and hands-on security labs.`}>
  <header class="article-header container">
    <div class="article-kicker">About <span>/</span> Profile</div>
    <h1 class="article-title">I’m interested in the failure modes.</h1>
    <p class="article-subtitle">
      I’m {SITE.name}, a cybersecurity-focused developer. I like the part where a system’s
      assumptions break — then designing the smallest change that makes it hold.
    </p>
  </header>

  <section class="section container">
    <SectionLabel index="01" label="The short version" />

    <div class="about-grid">
      <div class="about-copy reveal">
        <h2>Security is a property of the whole system.</h2>
        <p>
          My work sits between security and product. I built Ghost-Proxy, a self-hosted
          SOCKS5 tunnel with a TLS 1.3 + PSK design, because I wanted to understand what a
          private exit point actually costs: key distribution, metadata leakage, certificate
          lifecycle, and the operational details that decide whether a tool is usable.
        </p>
        <p>
          I built Guardian-Eye because a camera-only fall detector is easy to demo and hard
          to trust. Combining vision, gesture, and voice signals forced me to think about
          false positives, privacy boundaries, and fail-safe delivery — the parts that matter
          when software is supposed to help a person in trouble.
        </p>
        <p>
          I’m currently exploring security engineering, SOC analysis, and offensive security.
          I’m looking for a junior role or collaboration where I can keep building, keep
          documenting, and learn from people who care about the details.
        </p>
      </div>

      <div class="principles reveal" aria-label="How I work">
        <div class="principle">
          <span class="principle-number">01</span>
          <div>
            <h3 class="principle-title">Threat model first</h3>
            <p class="principle-text">Know what you’re protecting and who you’re protecting it from before choosing tools.</p>
          </div>
        </div>
        <div class="principle">
          <span class="principle-number">02</span>
          <div>
            <h3 class="principle-title">Make the secure path the easy path</h3>
            <p class="principle-text">Security that requires heroics gets bypassed. Defaults matter.</p>
          </div>
        </div>
        <div class="principle">
          <span class="principle-number">03</span>
          <div>
            <h3 class="principle-title">Document the limits</h3>
            <p class="principle-text">A known limitation is engineering. An unknown one is a vulnerability.</p>
          </div>
        </div>
        <div class="principle">
          <span class="principle-number">04</span>
          <div>
            <h3 class="principle-title">Test only what you own</h3>
            <p class="principle-text">Labs are isolated; testing is authorized. No exceptions.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="toolbox reveal">
      {toolbox.map((group) => (
        <div class="tool-group">
          <div class="tool-label">{group.label}</div>
          <div class="tool-items">
            {group.items.map((item) => <span class="chip">{item}</span>)}
          </div>
        </div>
      ))}
    </div>

    <div class="now-strip reveal">
      <div class="now-item">
        <div class="now-label">Building</div>
        <div class="now-value">Ghost-Proxy <span>packaging, TLS automation, protocol hardening</span></div>
      </div>
      <div class="now-item">
        <div class="now-label">Learning</div>
        <div class="now-value">Detection engineering <span>web security, cloud networking</span></div>
      </div>
      <div class="now-item">
        <div class="now-label">Open to</div>
        <div class="now-value">Security engineering <span>SOC, offensive security, collaboration</span></div>
      </div>
    </div>
  </section>

  <section class="section container">
    <SectionLabel index="02" label="Elsewhere" />

    <div class="contact-panel reveal">
      <h2>Want the longer conversation?</h2>
      <p>
        The best way to understand my work is to read a case study or a lab note. If you want
        to talk about a role, a project, or a detail I got wrong, email is the fastest route.
      </p>
      <div class="contact-actions">
        <a class="button button-primary" href={`mailto:${SITE.email}`}>Email me <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href={SITE.githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
        {SITE.linkedinUrl && (
          <a class="button button-ghost" href={SITE.linkedinUrl} target="_blank" rel="noreferrer">LinkedIn ↗</a>
        )}
        {SITE.resumeUrl && (
          <a class="button button-ghost" href={SITE.resumeUrl} target="_blank" rel="noreferrer">Résumé ↗</a>
        )}
      </div>
      <p class="micro">
        No trackers. No cookies. This site is static and the source is on GitHub.
      </p>
    </div>
  </section>
</BaseLayout>
