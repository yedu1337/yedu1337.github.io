---
import { SITE } from '../consts';
---

<div
  class="terminal"
  data-terminal
  data-email={SITE.email}
  data-github={SITE.githubUrl}
  data-ghost={`${SITE.githubUrl}/Ghost-Proxy`}
  data-guardian={`${SITE.githubUrl}/Guardian-Eye`}
>
  <div class="terminal-bar">
    <div class="terminal-dots" aria-hidden="true">
      <span class="dot dot-red"></span>
      <span class="dot dot-amber"></span>
      <span class="dot dot-green"></span>
    </div>
    <span class="terminal-title">yedukrishna@portfolio:~</span>
  </div>

  <div class="terminal-body" data-terminal-body>
    <div class="terminal-output" data-terminal-output aria-live="polite">
      <div class="term-line"><span class="term-prompt">$</span> <span class="term-command">whoami</span></div>
      <div class="term-line"><span class="term-accent">Yedukrishna</span> <span class="term-muted">— cybersecurity-focused developer</span></div>
      <div class="term-line"><span class="term-prompt">$</span> <span class="term-command">ls work</span></div>
      <div class="term-line"><span class="term-accent">ghost-proxy/</span>  <span class="term-accent">guardian-eye/</span></div>
      <div class="term-line"><span class="term-prompt">$</span> <span class="term-command">cat focus.txt</span></div>
      <div class="term-line"><span class="term-muted">network security · applied crypto · real-time detection</span></div>
    </div>

    <form class="term-form" data-terminal-form>
      <span class="term-prompt" aria-hidden="true">$</span>
      <input
        class="term-input"
        type="text"
        name="command"
        placeholder="type a command…"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="Terminal command input"
        data-terminal-input
      />
    </form>
  </div>
</div>

<div class="terminal-hint">
  <span>Try</span>
  <code>help</code>
  <span>·</span>
  <code>ls work</code>
  <span>·</span>
  <code>cat ghost-proxy</code>
  <span>·</span>
  <code>sudo hire-me</code>
</div>

<script>
  const terminalElement = document.querySelector<HTMLElement>('[data-terminal]');
  const bodyElement = terminalElement?.querySelector<HTMLElement>('[data-terminal-body]');
  const outputElement = terminalElement?.querySelector<HTMLElement>('[data-terminal-output]');
  const formElement = terminalElement?.querySelector<HTMLFormElement>('[data-terminal-form]');
  const inputElement = terminalElement?.querySelector<HTMLInputElement>('[data-terminal-input]');

  if (terminalElement && bodyElement && outputElement && formElement && inputElement) {
    const terminal = terminalElement;
    const body = bodyElement;
    const output = outputElement;
    const form = formElement;
    const input = inputElement;
    const email = terminal.dataset.email ?? '';
    const github = terminal.dataset.github ?? '';
    const ghost = terminal.dataset.ghost ?? '';
    const guardian = terminal.dataset.guardian ?? '';
    const history: string[] = [];
    let historyIndex = 0;

    const escapeHtml = (value: string) =>
      value.replace(/[&<>"']/g, (char) => {
        const map: Record<string, string> = {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        };
        return map[char] ?? char;
      });

    function print(html: string) {
      const line = document.createElement('div');
      line.className = 'term-line';
      line.innerHTML = html;
      output.appendChild(line);
      body.scrollTop = body.scrollHeight;
    }

    function printCommand(raw: string) {
      print(`<span class="term-prompt">$</span> <span class="term-command">${escapeHtml(raw)}</span>`);
    }

    function link(href: string, label: string) {
      return `<a class="term-link" href="${href}" target="_blank" rel="noreferrer">${label}</a>`;
    }

    function run(raw: string) {
      const command = raw.trim();
      if (!command) return;
      printCommand(command);
      history.push(command);
      historyIndex = history.length;

      const [name, ...args] = command.toLowerCase().split(/\s+/);
      const arg = args.join(' ');

      switch (name) {
        case 'help':
          print('<span class="term-muted">Available commands:</span>');
          print('  <span class="term-accent">whoami</span>        who is behind this terminal');
          print('  <span class="term-accent">ls</span>            list sections');
          print('  <span class="term-accent">ls work</span>       list selected projects');
          print('  <span class="term-accent">cat</span> &lt;project&gt;  read a project summary');
          print('  <span class="term-accent">contact</span>       how to reach me');
          print('  <span class="term-accent">theme</span>         toggle light / dark');
          print('  <span class="term-accent">nmap</span>          scan the portfolio (safe)');
          print('  <span class="term-accent">clear</span>         clear the screen');
          print('  <span class="term-accent">sudo hire-me</span>  try it');
          break;

        case 'whoami':
          print('<span class="term-accent">Yedukrishna</span> <span class="term-muted">— cybersecurity-focused developer</span>');
          print('<span class="term-muted">I build tools that make systems harder to break.</span>');
          break;

        case 'ls':
          if (arg === 'work' || arg === 'projects') {
            print(`<span class="term-accent">ghost-proxy/</span>   ${link(ghost, 'encrypted SOCKS5 tunnel')}`);
            print(`<span class="term-accent">guardian-eye/</span>  ${link(guardian, 'real-time emergency detection')}`);
          } else {
            print('<span class="term-accent">work/</span>  <span class="term-accent">lab/</span>  <span class="term-accent">about/</span>  <span class="term-accent">contact/</span>');
          }
          break;

        case 'cat':
          if (arg === 'ghost-proxy' || arg === 'ghost') {
            print('<span class="term-muted">Ghost-Proxy — a self-hosted SOCKS5 proxy with a TLS 1.3 + PSK tunnel.</span>');
            print('<span class="term-muted">ChaCha20-Poly1305 · traffic padding · single binary · MIT</span>');
            print(link(ghost, 'open repository ↗'));
          } else if (arg === 'guardian-eye' || arg === 'guardian') {
            print('<span class="term-muted">Guardian-Eye — multi-modal fall, gesture, and voice emergency detection.</span>');
            print('<span class="term-muted">YOLOv8 · Vosk · timed sensor fusion · Telegram / Firebase / GSM</span>');
            print(link(guardian, 'open repository ↗'));
          } else if (arg === 'about' || arg === 'focus.txt') {
            print('<span class="term-muted">Security-focused builder. I like understanding how systems fail, then building the fix.</span>');
            print('<span class="term-muted">Currently exploring security engineering, SOC analysis, and offensive security.</span>');
          } else {
            print('<span class="term-amber">cat: specify a file. try `cat ghost-proxy` or `cat guardian-eye`.</span>');
          }
          break;

        case 'contact':
          print(`<span class="term-muted">email   </span> ${link(`mailto:${email}`, email)}`);
          print(`<span class="term-muted">github  </span> ${link(github, github.replace('https://', ''))}`);
          print('<span class="term-muted">status  </span> <span class="term-accent">open to opportunities</span>');
          break;

        case 'theme':
          document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click();
          print('<span class="term-muted">theme toggled.</span>');
          break;

        case 'nmap':
          print('<span class="term-muted">Starting Nmap 7.95 ( https://nmap.org )</span>');
          print('<span class="term-muted">Nmap scan report for portfolio (127.0.0.1)</span>');
          print('<span class="term-muted">PORT     STATE SERVICE</span>');
          print('<span class="term-accent">443/tcp  open  https</span>');
          print('<span class="term-accent">22/tcp   open  ssh</span>       <span class="term-muted"># nice try</span>');
          print('<span class="term-accent">1337/tcp open  curiosity</span>');
          print('<span class="term-muted">Nmap done: 1 IP address (1 host up) scanned in 0.42 seconds</span>');
          break;

        case 'sudo':
          if (arg === 'hire-me' || arg === 'hire' || arg === 'hire-me!') {
            print('<span class="term-muted">[sudo] password for recruiter: ********</span>');
            print('<span class="term-accent">Access granted.</span> <span class="term-muted">Let’s talk.</span>');
            print(link(`mailto:${email}`, 'open a conversation ↗'));
          } else {
            print('<span class="term-amber">sudo: permission denied. try `sudo hire-me`.</span>');
          }
          break;

        case 'date':
          print(`<span class="term-muted">${new Date().toString()}</span>`);
          break;

        case 'history':
          if (history.length === 0) {
            print('<span class="term-muted">no history yet.</span>');
          } else {
            history.forEach((item, index) => print(`<span class="term-muted">${String(index + 1).padStart(2, '0')}  ${escapeHtml(item)}</span>`));
          }
          break;

        case 'clear':
          output.innerHTML = '';
          break;

        case 'exit':
          print('<span class="term-muted">There is no exit. Try `contact`.</span>');
          break;

        default:
          print(`<span class="term-amber">command not found: ${escapeHtml(command)}</span>`);
          print('<span class="term-muted">type `help` for available commands.</span>');
      }

      body.scrollTop = body.scrollHeight;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      run(input.value);
      input.value = '';
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (history.length === 0) return;
        historyIndex = Math.max(0, historyIndex - 1);
        input.value = history[historyIndex] ?? '';
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (history.length === 0) return;
        historyIndex = Math.min(history.length, historyIndex + 1);
        input.value = history[historyIndex] ?? '';
      }
    });

    body.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) return;
      input.focus();
    });
  }
</script>
