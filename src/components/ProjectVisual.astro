---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<div class="diagram">
  {slug === 'ghost-proxy' ? (
    <svg viewBox="0 0 560 320" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Ghost-Proxy architecture: a browser connects to a local SOCKS5 client, which opens a TLS 1.3 encrypted tunnel to a gateway that forwards allowed destinations.">
      <defs>
        <pattern id="gp-grid" width="24" height="24" patternUnits="userSpaceOnUse">
          <path d="M 24 0 L 0 0 0 24" stroke="#1b2937" stroke-width="0.6" />
        </pattern>
        <marker id="gp-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#617182" />
        </marker>
        <marker id="gp-arrow-accent" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#7cf5b0" />
        </marker>
      </defs>

      <rect width="560" height="320" fill="url(#gp-grid)" opacity="0.55" />
      <text x="22" y="32" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="8" letter-spacing="1.6">GHOST-PROXY / TUNNEL</text>
      <text x="538" y="32" text-anchor="end" fill="#7cf5b0" font-family="'JetBrains Mono', monospace" font-size="8">v0.2.1</text>

      <rect x="22" y="122" width="88" height="76" rx="8" fill="#0d141d" stroke="#2b3f52" />
      <text x="66" y="151" text-anchor="middle" fill="#e8eef4" font-family="'JetBrains Mono', monospace" font-size="10">Browser</text>
      <text x="66" y="167" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7.5">SOCKS5</text>
      <text x="66" y="181" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7.5">local app</text>

      <path d="M110 160 H144" stroke="#617182" stroke-width="1.2" marker-end="url(#gp-arrow)" />

      <rect x="150" y="108" width="120" height="104" rx="8" fill="#0d141d" stroke="#7cf5b0" stroke-opacity="0.55" />
      <text x="210" y="138" text-anchor="middle" fill="#e8eef4" font-family="'JetBrains Mono', monospace" font-size="10">Ghost client</text>
      <text x="210" y="154" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7.5">127.0.0.1:1080</text>
      <text x="210" y="170" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7.5">single binary</text>
      <rect x="174" y="184" width="72" height="15" rx="3" fill="#7cf5b0" fill-opacity="0.08" stroke="#7cf5b0" stroke-opacity="0.25" />
      <text x="210" y="194" text-anchor="middle" fill="#7cf5b0" font-family="'JetBrains Mono', monospace" font-size="7">local only</text>

      <path d="M270 160 H346" stroke="#7cf5b0" stroke-width="1.4" stroke-dasharray="4 4" marker-end="url(#gp-arrow-accent)" />
      <text x="308" y="136" text-anchor="middle" fill="#7cf5b0" font-family="'JetBrains Mono', monospace" font-size="7.5">TLS 1.3 + PSK</text>
      <text x="308" y="184" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7">ChaCha20-Poly1305</text>
      <text x="308" y="196" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7">traffic padding</text>

      <rect x="350" y="108" width="120" height="104" rx="8" fill="#0d141d" stroke="#7cf5b0" stroke-opacity="0.55" />
      <text x="410" y="138" text-anchor="middle" fill="#e8eef4" font-family="'JetBrains Mono', monospace" font-size="10">Ghost gateway</text>
      <text x="410" y="154" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7.5">unprivileged service</text>
      <text x="410" y="170" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7.5">allowlisted egress</text>
      <rect x="374" y="184" width="72" height="15" rx="3" fill="#7cf5b0" fill-opacity="0.08" stroke="#7cf5b0" stroke-opacity="0.25" />
      <text x="410" y="194" text-anchor="middle" fill="#7cf5b0" font-family="'JetBrains Mono', monospace" font-size="7">TLS 1.3</text>

      <path d="M470 160 H496" stroke="#617182" stroke-width="1.2" marker-end="url(#gp-arrow)" />
      <rect x="500" y="128" width="40" height="64" rx="20" fill="#0d141d" stroke="#2b3f52" />
      <text x="520" y="154" text-anchor="middle" fill="#e8eef4" font-family="'JetBrains Mono', monospace" font-size="7.5">Inter-</text>
      <text x="520" y="165" text-anchor="middle" fill="#e8eef4" font-family="'JetBrains Mono', monospace" font-size="7.5">net</text>
      <text x="520" y="180" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7">:443</text>

      <path d="M22 256 H538" stroke="#1b2937" stroke-width="0.6" stroke-dasharray="2 4" />
      <text x="22" y="280" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7.5">traffic padding · destination allowlist · SHA256SUMS · MIT</text>
      <text x="538" y="280" text-anchor="end" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7.5">2026</text>
    </svg>
  ) : (
    <svg viewBox="0 0 560 320" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Guardian-Eye architecture: camera and microphone signals feed YOLOv8 and Vosk, then a timed decision engine sends alerts to Firebase, Telegram, and GSM.">
      <defs>
        <pattern id="ge-grid" width="24" height="24" patternUnits="userSpaceOnUse">
          <path d="M 24 0 L 0 0 0 24" stroke="#1b2937" stroke-width="0.6" />
        </pattern>
        <marker id="ge-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#617182" />
        </marker>
        <marker id="ge-arrow-accent" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#7cf5b0" />
        </marker>
      </defs>

      <rect width="560" height="320" fill="url(#ge-grid)" opacity="0.55" />
      <text x="22" y="32" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="8" letter-spacing="1.6">GUARDIAN-EYE / SENSOR FUSION</text>
      <text x="538" y="32" text-anchor="end" fill="#7cf5b0" font-family="'JetBrains Mono', monospace" font-size="8">3 SIGNALS</text>

      <rect x="22" y="48" width="96" height="62" rx="8" fill="#0d141d" stroke="#2b3f52" />
      <text x="70" y="74" text-anchor="middle" fill="#e8eef4" font-family="'JetBrains Mono', monospace" font-size="10">Camera</text>
      <text x="70" y="90" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7.5">vision stream</text>

      <rect x="22" y="210" width="96" height="62" rx="8" fill="#0d141d" stroke="#2b3f52" />
      <text x="70" y="236" text-anchor="middle" fill="#e8eef4" font-family="'JetBrains Mono', monospace" font-size="10">Microphone</text>
      <text x="70" y="252" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7.5">audio stream</text>

      <path d="M118 79 H144" stroke="#617182" stroke-width="1.2" marker-end="url(#ge-arrow)" />
      <path d="M118 241 H144" stroke="#617182" stroke-width="1.2" marker-end="url(#ge-arrow)" />

      <rect x="148" y="48" width="96" height="62" rx="8" fill="#0d141d" stroke="#2b3f52" />
      <text x="196" y="74" text-anchor="middle" fill="#e8eef4" font-family="'JetBrains Mono', monospace" font-size="10">YOLOv8</text>
      <text x="196" y="90" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7.5">pose + gestures</text>

      <rect x="148" y="210" width="96" height="62" rx="8" fill="#0d141d" stroke="#2b3f52" />
      <text x="196" y="236" text-anchor="middle" fill="#e8eef4" font-family="'JetBrains Mono', monospace" font-size="10">Vosk</text>
      <text x="196" y="252" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7.5">keyword spotting</text>

      <path d="M244 79 H268 V140 H288" stroke="#617182" stroke-width="1.2" marker-end="url(#ge-arrow)" />
      <path d="M244 241 H268 V180 H288" stroke="#617182" stroke-width="1.2" marker-end="url(#ge-arrow)" />
      <text x="252" y="126" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7">pose</text>
      <text x="252" y="194" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7">keywords</text>

      <rect x="292" y="118" width="110" height="84" rx="8" fill="#0d141d" stroke="#7cf5b0" stroke-opacity="0.6" />
      <text x="347" y="146" text-anchor="middle" fill="#e8eef4" font-family="'JetBrains Mono', monospace" font-size="10">Decision</text>
      <text x="347" y="159" text-anchor="middle" fill="#e8eef4" font-family="'JetBrains Mono', monospace" font-size="10">engine</text>
      <text x="347" y="178" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7">timed rules</text>
      <text x="347" y="190" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7">false-positive guard</text>

      <path d="M402 140 H424 V72 H442" stroke="#7cf5b0" stroke-width="1.2" marker-end="url(#ge-arrow-accent)" />
      <path d="M402 160 H442" stroke="#7cf5b0" stroke-width="1.2" marker-end="url(#ge-arrow-accent)" />
      <path d="M402 180 H424 V240 H442" stroke="#7cf5b0" stroke-width="1.2" marker-end="url(#ge-arrow-accent)" />

      <rect x="446" y="48" width="92" height="48" rx="7" fill="#0d141d" stroke="#2b3f52" />
      <text x="492" y="68" text-anchor="middle" fill="#e8eef4" font-family="'JetBrains Mono', monospace" font-size="9">Firebase</text>
      <text x="492" y="82" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7">live dashboard</text>

      <rect x="446" y="136" width="92" height="48" rx="7" fill="#0d141d" stroke="#2b3f52" />
      <text x="492" y="156" text-anchor="middle" fill="#e8eef4" font-family="'JetBrains Mono', monospace" font-size="9">Telegram</text>
      <text x="492" y="170" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7">instant alert</text>

      <rect x="446" y="224" width="92" height="48" rx="7" fill="#0d141d" stroke="#2b3f52" />
      <text x="492" y="244" text-anchor="middle" fill="#e8eef4" font-family="'JetBrains Mono', monospace" font-size="9">GSM</text>
      <text x="492" y="258" text-anchor="middle" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7">SMS fallback</text>

      <path d="M22 296 H538" stroke="#1b2937" stroke-width="0.6" stroke-dasharray="2 4" />
      <text x="22" y="314" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7.5">on-device vision · timed fusion · multi-channel alerts</text>
      <text x="538" y="314" text-anchor="end" fill="#617182" font-family="'JetBrains Mono', monospace" font-size="7.5">2026</text>
    </svg>
  )}
</div>
