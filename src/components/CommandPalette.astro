---
import { SITE } from '../consts';
---

<div class="palette" data-palette data-email={SITE.email} data-github={SITE.githubUrl} hidden>
  <div class="palette-backdrop" data-palette-close></div>
  <div class="palette-dialog" role="dialog" aria-modal="true" aria-label="Command palette">
    <div class="palette-input-wrap">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        class="palette-input"
        type="search"
        placeholder="Jump to a page, project, or action…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search pages and actions"
        aria-controls="palette-list"
        aria-autocomplete="list"
        data-palette-input
      />
    </div>
    <div class="palette-list" id="palette-list" role="listbox" aria-label="Results" data-palette-list></div>
    <div class="palette-footer">
      <span>↑↓ navigate</span>
      <span>↵ open</span>
      <span>esc close</span>
    </div>
  </div>
</div>

<script>
  type PaletteItem = {
    label: string;
    hint: string;
    keywords?: string;
    href?: string;
    external?: boolean;
    action?: () => void;
  };

  const paletteElement = document.querySelector<HTMLElement>('[data-palette]');
  const inputElement = document.querySelector<HTMLInputElement>('[data-palette-input]');
  const listElement = document.querySelector<HTMLElement>('[data-palette-list]');

  if (paletteElement && inputElement && listElement) {
    const palette = paletteElement;
    const input = inputElement;
    const list = listElement;
    const email = palette.dataset.email ?? '';
    const github = palette.dataset.github ?? '';
    let selected = 0;
    let filtered: PaletteItem[] = [];
    let lastTrigger: HTMLElement | null = null;

    function showToast(message: string) {
      const toast = document.querySelector<HTMLElement>('[data-copy-toast]');
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add('is-visible');
      window.setTimeout(() => toast.classList.remove('is-visible'), 2200);
    }

    async function copyEmail() {
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = email;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
      }
      showToast('Email copied to clipboard');
    }

    const items: PaletteItem[] = [
      { label: 'Home', hint: 'Page', href: '/' },
      { label: 'Selected work', hint: 'Page', href: '/work/' },
      { label: 'Ghost-Proxy case study', hint: 'Project', href: '/work/ghost-proxy/', keywords: 'go socks5 tls proxy' },
      { label: 'Guardian-Eye case study', hint: 'Project', href: '/work/guardian-eye/', keywords: 'python vision fall detection' },
      { label: 'Lab notes', hint: 'Page', href: '/lab/' },
      { label: 'About', hint: 'Page', href: '/about/' },
      { label: 'Contact', hint: 'Section', href: '/#contact' },
      { label: 'Security & disclosure', hint: 'Page', href: '/security/' },
      { label: 'GitHub profile', hint: 'External', href: github, external: true },
      { label: 'Copy email address', hint: 'Action', action: copyEmail },
      {
        label: 'Toggle color theme',
        hint: 'Action',
        action: () => document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click(),
      },
    ];

    function render(query = '') {
      const q = query.trim().toLowerCase();
      filtered = items.filter((item) => {
        if (!q) return true;
        return `${item.label} ${item.hint} ${item.keywords ?? ''}`.toLowerCase().includes(q);
      });
      selected = Math.min(selected, Math.max(0, filtered.length - 1));
      list.innerHTML = '';

      if (filtered.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'palette-empty';
        empty.textContent = 'No results. Try “work”, “lab”, or “email”.';
        list.appendChild(empty);
        return;
      }

      filtered.forEach((item, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `palette-item${index === selected ? ' is-selected' : ''}`;
        button.setAttribute('role', 'option');
        button.setAttribute('aria-selected', String(index === selected));
        button.dataset.index = String(index);

        const label = document.createElement('span');
        label.textContent = item.label;

        const hint = document.createElement('span');
        hint.className = 'palette-item-hint';
        hint.textContent = item.hint;

        button.append(label, hint);
        button.addEventListener('click', () => activate(item));
        list.appendChild(button);
      });
    }

    function activate(item: PaletteItem) {
      close();
      if (item.action) {
        item.action();
        return;
      }
      if (!item.href) return;
      if (item.external) {
        window.open(item.href, '_blank', 'noopener,noreferrer');
      } else {
        window.location.href = item.href;
      }
    }

    function move(delta: number) {
      if (filtered.length === 0) return;
      selected = (selected + delta + filtered.length) % filtered.length;
      render(input.value);
      const active = list.querySelector<HTMLElement>(`.palette-item[data-index="${selected}"]`);
      active?.scrollIntoView({ block: 'nearest' });
    }

    function open(trigger?: HTMLElement) {
      lastTrigger = trigger ?? (document.activeElement as HTMLElement | null);
      palette.hidden = false;
      document.body.classList.add('is-locked');
      input.value = '';
      selected = 0;
      render();
      window.setTimeout(() => input.focus(), 0);
    }

    function close() {
      palette.hidden = true;
      document.body.classList.remove('is-locked');
      lastTrigger?.focus();
    }

    document.querySelectorAll<HTMLElement>('[data-palette-open]').forEach((button) => {
      button.addEventListener('click', () => open(button));
    });

    document.querySelectorAll<HTMLElement>('[data-palette-close]').forEach((element) => {
      element.addEventListener('click', close);
    });

    input.addEventListener('input', () => {
      selected = 0;
      render(input.value);
    });

    document.addEventListener('keydown', (event) => {
      const isOpen = !palette.hidden;

      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (isOpen) close();
        else open();
        return;
      }

      if (!isOpen) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        close();
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        move(1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        move(-1);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        const item = filtered[selected];
        if (item) activate(item);
      }
    });
  }
</script>
