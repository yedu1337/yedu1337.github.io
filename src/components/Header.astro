---
import { NAV, SITE } from '../consts';

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  if (href.startsWith('/#')) return false;
  return pathname === href || pathname.startsWith(href);
};
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} — home`}>
      <span class="brand-mark" aria-hidden="true">&gt;_</span>
      <span class="brand-text">{SITE.name}<span class="accent">.</span></span>
    </a>

    <nav class="site-nav" id="site-nav" data-nav aria-label="Primary navigation">
      {NAV.map((item) => (
        <a class:list={['nav-link', { 'is-active': isActive(item.href) }]} href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="kbd-button" type="button" data-palette-open aria-keyshortcuts="Control+K Meta+K">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="kbd-label">Search</span>
        <span class="kbd" aria-hidden="true">⌘K</span>
      </button>

      <button class="icon-button" type="button" data-theme-toggle aria-label="Switch to light theme">
        <svg class="theme-icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="theme-icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.6 6.6 0 0 0 21 12.8Z"></path>
        </svg>
      </button>

      <a class="icon-button" href={SITE.githubUrl} target="_blank" rel="noreferrer" aria-label="GitHub profile">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.33.95.1-.74.4-1.24.73-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"></path>
        </svg>
      </a>

      <button class="mobile-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav" aria-label="Toggle navigation">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  [data-theme='dark'] .theme-icon-sun {
    display: block;
  }
  [data-theme='dark'] .theme-icon-moon {
    display: none;
  }
  [data-theme='light'] .theme-icon-sun {
    display: none;
  }
  [data-theme='light'] .theme-icon-moon {
    display: block;
  }
</style>
