---
import { SITE } from '../consts';

const year = new Date().getFullYear();
const buildDate = new Date().toISOString().slice(0, 10);
const sourceUrl = `${SITE.githubUrl}/${SITE.handle}.github.io`;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="brand-mark" aria-hidden="true">&gt;_</span>
      <span>© {year} {SITE.name}. Built with Astro.</span>
    </div>

    <nav class="footer-links" aria-label="Footer links">
      <a href={SITE.githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
      <a href={`mailto:${SITE.email}`}>Email</a>
      <a href="/rss.xml">RSS</a>
      <a href="/security/">Security</a>
      <a href="/.well-known/security.txt">security.txt</a>
      <a href={sourceUrl} target="_blank" rel="noreferrer">Source ↗</a>
    </nav>

    <div class="footer-meta">
      Static site · no trackers · no cookies · last build {buildDate}
    </div>
  </div>
</footer>
